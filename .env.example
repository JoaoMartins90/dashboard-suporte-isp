# Copie este arquivo para .env e preencha com os valores reais.
# O .env NAO deve ser versionado - ele esta no .gitignore.
#
# So e necessario para conectar a uma base PostgreSQL real. Para rodar com a
# base de exemplo, basta "python seed.py" - nenhuma variavel e exigida.

# --- Banco de dados (PostgreSQL / MK Solutions) ---
DB_USERNAME=usuario
DB_PASSWORD=senha
DB_HOST=localhost
DB_PORT=5432
DB_DB=nome_do_banco
